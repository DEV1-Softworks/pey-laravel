{
    "name": "dev1/pey-laravel",
    "description": "Unofficial Laravel integration for the Pey API (CoDi payments, Mexico). Not affiliated with Pey or Banco de México.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "pey",
        "codi",
        "banxico",
        "payments",
        "mexico",
        "laravel",
        "webhooks"
    ],
    "homepage": "https://github.com/DEV1-Softworks/pey-laravel",
    "support": {
        "issues": "https://github.com/DEV1-Softworks/pey-laravel/issues",
        "source": "https://github.com/DEV1-Softworks/pey-laravel"
    },
    "authors": [
        {
            "name": "DEV1 Softworks Labs",
            "email": "it@dev1.mx"
        }
    ],
    "require": {
        "php": "^8.2",
        "dev1/pey-php-sdk": "^0.1.1",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "psr/clock": "^1.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.15",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Dev1\\Pey\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dev1\\Pey\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dev1\\Pey\\Laravel\\PeyServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover build/coverage.xml --coverage-text",
            "@php tools/coverage-check.php build/coverage.xml"
        ],
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "test:coverage": "Run the test suite with coverage and enforce the coverage thresholds.",
        "analyse": "Run PHPStan at level max with strict rules and Larastan (no baseline).",
        "cs": "Check coding standards (PER-CS) without modifying files.",
        "cs:fix": "Fix coding standards (PER-CS) in place."
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
